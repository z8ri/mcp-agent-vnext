# 复制为 .env 后填入真实值，.env 本身不进 git

# ---- 运行模式 ----
# true: 用内置的 mocked LLM / mocked Provider 跑通全流程，不需要真实 Key
# false: 调真实通义千问 / OpenWeather / 地图服务
MOCK_MODE=true

# ---- 通义千问（Qwen） ----
DASHSCOPE_API_KEY=
# 用经典命名（qwen-turbo / qwen-plus / qwen-max）。百炼控制台"免费额度"页面
# 列出来的那些版本号式命名（比如 qwen3.8-flash）是走别的接口的，直接填给
# ChatTongyi 会报 400 InvalidParameter: url error，这个坑真的踩过一次。
QWEN_MODEL=qwen-plus

# ---- 天气 Provider（可选，MOCK_MODE=false 时需要） ----
OPENWEATHER_API_KEY=

# ---- 地图 MCP Server ----
# 默认使用自建的 Nominatim（OpenStreetMap）地图 Server，不需要 Key。
# 如果要换成高德官方 MCP，把下面这个改成高德的 URL 和 Key。
MAP_MCP_URL=http://localhost:8811/mcp
MAP_MCP_API_KEY=

# ---- 鉴权 ----
# 必须换成至少 32 字节的随机字符串，比如：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long
JWT_EXPIRE_MINUTES=1440

# ---- 数据库 ----
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite3
IDEMPOTENCY_DB_PATH=./data/idempotency.sqlite3
TRACE_DB_PATH=./data/trace.sqlite3
BUDGET_DB_PATH=./data/budget.sqlite3
BAD_CASE_DB_PATH=./data/bad_cases.sqlite3

# ---- 成本预算 ----
# 单个用户累计花费（美元）超过这个数，/chat 会直接拒绝（402），不会再调模型。
BUDGET_MAX_COST_USD_PER_USER=1.0

# ---- 数据保留 ----
# trace_spans 每次模型/工具调用都落一条，没有清理会无限增长；进程每次启动时
# 清一次超过这个天数的旧 span（idempotency_keys 按各自的 TTL、bad_cases 里
# 已处理超过 30 天的记录也在同一时机清，这两个目前没有单独开配置项）。
TRACE_RETENTION_DAYS=30

# ---- 限流 ----
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_MINUTE=10.0

# ---- CORS ----
# 逗号分隔的允许来源，不用 *
CORS_ALLOWED_ORIGINS=http://localhost:5173
